---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Visor from '@/components/Visor.astro';
import PantallaEntrada from '@/components/PantallaEntrada.astro';
import { SITE } from '@/config/site';
import { localBusinessSchema } from '@/lib/schema';

interface Props {
  title: string;
  description?: string;
  /** Ruta absoluta o relativa al sitio de la imagen OG (1200×630). */
  ogImage?: string;
  /** JSON-LD adicional propio de la página. */
  schema?: object[];
  noindex?: boolean;
  /** Mensaje prellenado del botón flotante de WhatsApp en esta página. */
  waMessage?: string;
}

const { title, description = SITE.description, ogImage = '/og-default.jpg', schema = [], noindex = false, waMessage } =
  Astro.props;

const fullTitle = title === SITE.name ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const jsonLd = [localBusinessSchema(), ...schema];
const hayApi = Boolean(import.meta.env.PUBLIC_API_URL);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /*
       * Pantalla de entrada (components/PantallaEntrada.astro): se decide aquí, antes de pintar,
       * para que la página no alcance a verse debajo. Una vez por visita, o siempre con ?entrada=1.
       * A los 9 s se quita sola, por si el script que la cierra no llegara a cargar.
       */
    }
    <script is:inline>
      (function () {
        try {
          var forzada = /[?&]entrada=1/.test(location.search);
          if (!forzada && sessionStorage.getItem('ararat-entrada')) return;
          sessionStorage.setItem('ararat-entrada', '1');
          var html = document.documentElement;
          html.dataset.entrada = 'activa';
          setTimeout(function () {
            delete html.dataset.entrada;
          }, 9000);
        } catch (e) {
          /* sin sessionStorage no se muestra: saldría en cada página */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#12161c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / WhatsApp / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- SEO local -->
    <meta name="geo.region" content="CL-RM" />
    <meta name="geo.placename" content={SITE.address.city} />

    {jsonLd.map((data) => <script type="application/ld+json" data-schema={(data as { '@type'?: string })['@type']} set:html={JSON.stringify(data)} />)}
    {
      /*
       * Las zonas [data-contenido] parten ocultas (ver global.css) hasta que
       * scripts/contenido-cliente.ts las reemplaza con lo del panel web, para no mostrar
       * el respaldo y cambiarlo a la vista. A los 1,5 s se muestran igual, por si la API demora.
       */
      hayApi && (
        <script is:inline>
          document.documentElement.dataset.cargaContenido = 'pendiente';
          setTimeout(function () {
            document.documentElement.dataset.cargaContenido = 'lista';
          }, 1500);
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <PantallaEntrada />
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:p-3">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton message={waMessage} />
    <Visor />
  </body>
</html>
