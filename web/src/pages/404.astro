---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-2 text-5xl">Esta página no existe</h1>
      <p class="mt-4 text-acero-700">Puede que el enlace haya cambiado. Prueba desde el inicio o escríbenos.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">Ir al inicio</a>
        <a href="/contacto/" class="btn border border-acero-300 hover:bg-acero-100">Contacto</a>
      </div>
    </div>
  </section>
</BaseLayout>
