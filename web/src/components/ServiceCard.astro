---
import { Image } from 'astro:assets';
import type { Servicio } from '@/data/servicios';

interface Props {
  servicio: Pick<Servicio, 'title' | 'short' | 'image' | 'imageAlt'> & { slug?: string };
  /** Destino del enlace; por defecto, la página del servicio. */
  href?: string;
  cta?: string;
}
const { servicio: s, href = `/servicios/${s.slug}/`, cta = 'Ver servicio' } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-acero-100 transition hover:-translate-y-0.5 hover:shadow-md"
>
  {/* Las fotos de servicio llevan el título dentro de la imagen: se muestran completas, sin recorte. */}
  <Image
    src={s.image}
    alt={s.imageAlt}
    widths={[400, 640, 800]}
    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    class="aspect-[1279/925] w-full object-cover"
  />
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-2xl text-acero-900">{s.title}</h3>
    <p class="mt-2 flex-1 text-acero-700">{s.short}</p>
    <span class="mt-4 font-display font-semibold uppercase tracking-wide text-cian-600 group-hover:text-cian-500">
      {cta} →
    </span>
  </div>
</a>
