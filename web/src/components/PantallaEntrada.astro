---
/**
 * Pantalla de entrada: el banner de servicios a pantalla completa con un símbolo de carga.
 *
 * - Sale una vez por visita (por pestaña), en la primera página que se abre. La decisión la
 *   toma el script del <head> de BaseLayout, que pone data-entrada en <html>; sin JS no se muestra.
 * - Se cierra cuando la página terminó de cargar y la foto ya se vio un momento, o al tocarla.
 * - La foto solo se descarga cuando la pantalla se va a mostrar.
 * - Para verla de nuevo al probar: agrega ?entrada=1 a la dirección.
 */
import { getImage } from 'astro:assets';
import banner from '@/assets/img/entrada.jpg';

const [grande, chica] = await Promise.all([
  getImage({ src: banner, width: 1600, format: 'webp' }),
  getImage({ src: banner, width: 800, format: 'webp' }),
]);
const srcset = `${chica.src} 800w, ${grande.src} 1600w`;
---

<div
  class="fixed inset-0 z-[100] items-center justify-center overflow-hidden bg-black transition-opacity duration-500"
  role="status"
  aria-label="Cargando la página"
  data-entrada-pantalla
>
  {/* El mismo banner, ampliado y difuminado, rellena lo que la foto no cubre (p. ej. en un celular vertical). */}
  <img alt="" data-src={chica.src} class="absolute inset-0 size-full scale-110 object-cover opacity-40 blur-2xl" aria-hidden="true" />
  <img
    alt="Ararat: soldaduras, tornería, mantención industrial, servicio hidráulico, arriendo de maquinaria agrícola y grúa horquilla, y preparación racing"
    data-src={grande.src}
    data-srcset={srcset}
    sizes="100vw"
    class="relative max-h-full max-w-full object-contain"
    data-entrada-foto
  />
  <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-3 rounded-full bg-acero-950/85 py-2 pl-2 pr-5 text-white shadow-lg">
    <span class="size-9 animate-spin rounded-full border-4 border-white/25 border-t-cian-500" aria-hidden="true"></span>
    <span class="font-display text-lg font-semibold uppercase tracking-wide">Cargando…</span>
  </div>
</div>

<script is:inline>
  // Va pegado al marcado para pedir la foto de inmediato, antes de que cargue el resto de la página.
  (function () {
    if (!document.documentElement.dataset.entrada) return;
    document.querySelectorAll('[data-entrada-pantalla] img').forEach(function (img) {
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src;
    });
  })();
</script>

<script>
  // Tiempo mínimo con la foto a la vista, y máximo total por si algo demora en cargar.
  const MINIMO_MS = 2000;
  const MAXIMO_MS = 6000;
  const DESVANECER_MS = 500;

  const html = document.documentElement;
  const pantalla = document.querySelector<HTMLElement>('[data-entrada-pantalla]');
  const foto = pantalla?.querySelector<HTMLImageElement>('[data-entrada-foto]');

  if (pantalla && foto && html.dataset.entrada) {
    const espera = (ms: number) => new Promise((listo) => setTimeout(listo, ms));
    const paginaLista = new Promise<void>((listo) =>
      document.readyState === 'complete' ? listo() : window.addEventListener('load', () => listo(), { once: true }),
    );
    const fotoLista = new Promise<void>((listo) => {
      if (foto.complete) return listo();
      foto.addEventListener('load', () => listo(), { once: true });
      foto.addEventListener('error', () => listo(), { once: true });
    });

    let cerrada = false;
    const cerrar = () => {
      if (cerrada) return;
      cerrada = true;
      pantalla.dataset.cerrando = '';
      setTimeout(() => delete html.dataset.entrada, DESVANECER_MS);
    };

    Promise.all([paginaLista, fotoLista.then(() => espera(MINIMO_MS))]).then(cerrar);
    setTimeout(cerrar, MAXIMO_MS);
    pantalla.addEventListener('click', cerrar);
    document.addEventListener('keydown', cerrar, { once: true });
  }
</script>
