---
/**
 * Formulario de cotización → POST {PUBLIC_API_URL}/cotizaciones/
 *
 * Decisiones:
 * - Se envía como FormData (multipart): es una "petición simple" CORS, así que
 *   el navegador NO hace preflight OPTIONS. Menos superficie para que Imunify360
 *   bloquee algo y un viaje menos.
 * - Honeypot (`website`) + tiempo de llenado (`elapsed_ms`) contra bots.
 * - Si la API falla (caída, desafío de Imunify, CORS), el lead no se pierde:
 *   se ofrece enviar lo mismo por WhatsApp con el texto ya armado.
 * - Funciona sin frameworks: es HTML + un script pequeño.
 */
import { SERVICIOS } from '@/data/servicios';
import { SITE } from '@/config/site';

interface Props {
  /** slug preseleccionado (p. ej. 'soldadura' o 'arriendo') */
  servicio?: string;
  /** texto inicial del mensaje (p. ej. equipo de Kairos consultado) */
  mensaje?: string;
  dark?: boolean;
}
const { servicio = '', mensaje = '', dark = false } = Astro.props;

const apiBase = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
const endpoint = `${apiBase}/cotizaciones/`;

const opciones = [
  ...SERVICIOS.map((s) => ({ value: s.slug, label: s.title })),
  { value: 'arriendo', label: `Arriendo de equipos (${SITE.kairos.name})` },
  { value: 'pyrotect', label: 'Indumentaria racing (Pyrotect)' },
  { value: 'otro', label: 'Otro / no estoy seguro' },
];

const field =
  'mt-1 block w-full rounded-md border px-3 py-3 text-base outline-none transition focus:border-cian-500 focus:ring-2 focus:ring-cian-500/30';
const fieldTheme = dark ? 'border-white/15 bg-acero-900 text-white placeholder:text-acero-500' : 'border-acero-300 bg-white text-acero-900';
const label = dark ? 'text-sm font-medium text-acero-100' : 'text-sm font-medium text-acero-700';
---

<form
  class="grid gap-4 sm:grid-cols-2"
  novalidate
  data-quote-form
  data-endpoint={endpoint}
  data-wa={SITE.contact.whatsapp}
>
  <label class="block">
    <span class={label}>Nombre *</span>
    <input class:list={[field, fieldTheme]} name="nombre" autocomplete="name" required maxlength="120" />
  </label>

  <label class="block">
    <span class={label}>Empresa <span class="opacity-60">(opcional)</span></span>
    <input class:list={[field, fieldTheme]} name="empresa" autocomplete="organization" maxlength="120" />
  </label>

  <label class="block">
    <span class={label}>Teléfono / WhatsApp *</span>
    <input class:list={[field, fieldTheme]} name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="+56 9 1234 5678" maxlength="30" />
  </label>

  <label class="block">
    <span class={label}>Correo</span>
    <input class:list={[field, fieldTheme]} name="email" type="email" autocomplete="email" maxlength="254" />
  </label>

  <label class="block sm:col-span-2">
    <span class={label}>¿Qué necesitas? *</span>
    <select class:list={[field, fieldTheme]} name="servicio" required>
      <option value="">Selecciona un servicio</option>
      {opciones.map((o) => <option value={o.value} selected={o.value === servicio}>{o.label}</option>)}
    </select>
  </label>

  <label class="block sm:col-span-2">
    <span class={label}>Cuéntanos el trabajo *</span>
    <textarea
      class:list={[field, fieldTheme, 'min-h-32']}
      name="mensaje"
      required
      minlength="10"
      maxlength="3000"
      placeholder="Ej.: reparar soldadura de tolva, medidas aprox., ubicación de la faena, plazo…"
      set:text={mensaje}
    ></textarea>
  </label>

  <!-- Honeypot: invisible para personas, los bots lo llenan -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label>No llenar <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <p class:list={['text-sm sm:col-span-2', dark ? 'text-acero-300' : 'text-acero-500']}>
    * Déjanos al menos un teléfono o un correo para responderte.
  </p>

  <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row sm:items-center">
    <button type="submit" class="btn-primary sm:w-auto" data-submit>
      Enviar solicitud
    </button>
    <p class="text-sm" role="status" aria-live="polite" data-status></p>
  </div>

  <div class="hidden rounded-md border border-whatsapp/40 bg-whatsapp/10 p-4 sm:col-span-2" data-fallback>
    <p class:list={['mb-3 text-sm', dark ? 'text-acero-100' : 'text-acero-800']}>
      No pudimos enviar el formulario en este momento. Envíanos la misma solicitud por WhatsApp y te respondemos igual de rápido:
    </p>
    <a class="btn-whatsapp" target="_blank" rel="noopener" data-fallback-link href="#">Enviar por WhatsApp</a>
  </div>
</form>

<script>
  type Errors = Record<string, string[] | string>;

  const TIMEOUT_MS = 12000;

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    const startedAt = Date.now();
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const fallback = form.querySelector<HTMLElement>('[data-fallback]')!;
    const fallbackLink = form.querySelector<HTMLAnchorElement>('[data-fallback-link]')!;
    const select = form.querySelector<HTMLSelectElement>('select[name="servicio"]')!;

    // Preselección por URL: /contacto/?servicio=soldadura&equipo=Generador
    const params = new URLSearchParams(location.search);
    const qServicio = params.get('servicio');
    if (qServicio && [...select.options].some((o) => o.value === qServicio)) select.value = qServicio;
    const qEquipo = params.get('equipo');
    const textarea = form.querySelector<HTMLTextAreaElement>('textarea[name="mensaje"]')!;
    if (qEquipo && !textarea.value) textarea.value = `Quiero cotizar el arriendo de: ${qEquipo.slice(0, 100)}.\nFechas: \nLugar: `;
    // Productos Pyrotect: /contacto/?servicio=pyrotect&producto=Butacas
    const qProducto = params.get('producto');
    if (qProducto && !textarea.value) textarea.value = `Quiero cotizar productos Pyrotect: ${qProducto.slice(0, 100)}.\nModelo / talla: \nCantidad: `;

    const setStatus = (msg: string, kind: 'info' | 'ok' | 'error' = 'info') => {
      status.textContent = msg;
      status.className = 'text-sm ' + (kind === 'ok' ? 'text-green-600' : kind === 'error' ? 'text-red-600' : 'opacity-80');
    };

    const clearErrors = () => {
      form.querySelectorAll('[data-error]').forEach((el) => el.remove());
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    };

    const showErrors = (errors: Errors) => {
      Object.entries(errors).forEach(([name, msgs]) => {
        const input = form.elements.namedItem(name);
        const text = Array.isArray(msgs) ? msgs.join(' ') : String(msgs);
        if (input instanceof HTMLElement) {
          input.setAttribute('aria-invalid', 'true');
          const p = document.createElement('p');
          p.dataset.error = '';
          p.className = 'mt-1 text-sm text-red-600';
          p.textContent = text;
          input.insertAdjacentElement('afterend', p);
        } else {
          setStatus(text, 'error');
        }
      });
    };

    const validate = (data: FormData): Errors => {
      const e: Errors = {};
      const v = (k: string) => String(data.get(k) ?? '').trim();
      if (v('nombre').length < 2) e.nombre = 'Ingresa tu nombre.';
      if (!v('telefono') && !v('email')) e.telefono = 'Déjanos un teléfono o un correo.';
      if (v('telefono') && v('telefono').replace(/\D/g, '').length < 8) e.telefono = 'Revisa el número.';
      if (v('email') && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email'))) e.email = 'Revisa el correo.';
      if (!v('servicio')) e.servicio = 'Selecciona una opción.';
      if (v('mensaje').length < 10) e.mensaje = 'Cuéntanos un poco más (mínimo 10 caracteres).';
      return e;
    };

    const whatsappText = (data: FormData) => {
      const sel = select.selectedOptions[0]?.text ?? '';
      const lines = [
        'Hola, quiero cotizar:',
        `• Servicio: ${sel}`,
        `• Nombre: ${data.get('nombre')}`,
        data.get('empresa') ? `• Empresa: ${data.get('empresa')}` : '',
        `• Detalle: ${data.get('mensaje')}`,
      ];
      return lines.filter(Boolean).join('\n');
    };

    const showFallback = (data: FormData) => {
      fallbackLink.href = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(whatsappText(data))}`;
      fallback.classList.remove('hidden');
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      clearErrors();
      fallback.classList.add('hidden');

      const data = new FormData(form);
      const errors = validate(data);
      if (Object.keys(errors).length) {
        showErrors(errors);
        setStatus('Revisa los campos marcados.', 'error');
        return;
      }

      data.set('elapsed_ms', String(Date.now() - startedAt));
      data.set('origen', location.pathname);

      submit.disabled = true;
      setStatus('Enviando…');

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);

      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
          // Sin cookies: la API pública no usa sesión (evita CSRF y preflight).
          credentials: 'omit',
          signal: controller.signal,
        });

        if (res.status === 201 || res.ok) {
          form.reset();
          setStatus('¡Listo! Recibimos tu solicitud y te contactaremos pronto.', 'ok');
          return;
        }
        if (res.status === 400) {
          const body = await res.json().catch(() => ({}));
          showErrors(body as Errors);
          setStatus('Revisa los campos marcados.', 'error');
          return;
        }
        if (res.status === 429) {
          setStatus('Recibimos varias solicitudes seguidas desde tu conexión.', 'error');
          showFallback(data);
          return;
        }
        throw new Error(`HTTP ${res.status}`);
      } catch {
        // Red caída, timeout, CORS o desafío anti-bot (Imunify360 devuelve HTML sin cabeceras CORS).
        setStatus('');
        showFallback(data);
      } finally {
        clearTimeout(timer);
        submit.disabled = false;
      }
    });
  });
</script>
