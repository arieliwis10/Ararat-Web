---
import { waLink } from '@/lib/whatsapp';

interface Props {
  message?: string;
}
const { message } = Astro.props;
---

<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  class="fixed bottom-4 right-4 z-50 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg shadow-black/30 transition-transform hover:scale-105 sm:bottom-6 sm:right-6"
  aria-label="Escríbenos por WhatsApp"
  data-wa-float
>
  <svg viewBox="0 0 32 32" class="size-8" fill="currentColor" aria-hidden="true">
    <path
      d="M16.04 3C9.03 3 3.33 8.7 3.33 15.7c0 2.24.59 4.43 1.7 6.36L3.2 28.8l6.9-1.8a12.66 12.66 0 0 0 5.94 1.5h.01c7 0 12.7-5.7 12.7-12.7S23.05 3 16.04 3Zm0 23.27h-.01a10.5 10.5 0 0 1-5.36-1.47l-.38-.23-4.1 1.07 1.1-4-.25-.4a10.53 10.53 0 1 1 9 5.03Zm5.77-7.88c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.71.16-.21.31-.82 1.03-1 1.24-.19.21-.37.24-.69.08-.32-.16-1.34-.5-2.55-1.58-.94-.84-1.58-1.88-1.76-2.2-.19-.31-.02-.48.14-.64.14-.14.32-.37.48-.55.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.71-1.71-.98-2.35-.26-.62-.52-.53-.71-.54h-.61c-.21 0-.55.08-.84.4-.29.31-1.1 1.08-1.1 2.63s1.13 3.05 1.29 3.26c.16.21 2.22 3.39 5.38 4.75.75.32 1.34.52 1.8.66.75.24 1.44.2 1.98.12.6-.09 1.88-.77 2.14-1.51.27-.74.27-1.38.19-1.51-.08-.13-.29-.21-.6-.37Z"
    ></path>
  </svg>
</a>
