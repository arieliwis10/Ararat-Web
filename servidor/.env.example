# Copia este archivo como .env en /home/araratch/web.araratchile.com/ (NO se versiona).
# Genera SECRET_KEY con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=web.araratchile.com
CSRF_TRUSTED_ORIGINS=https://web.araratchile.com

# La web pública que consulta la API y envía cotizaciones
CORS_ALLOWED_ORIGINS=https://araratchile.com,https://www.araratchile.com
WEB_PUBLICA_URL=https://araratchile.com/

# Base de datos MySQL propia de la web (cPanel → Bases de datos MySQL)
DB_ENGINE=mysql
DB_NAME=araratch_web
DB_USER=araratch_web
DB_PASSWORD=
DB_HOST=localhost

# Correo (los mismos datos de mail.araratchile.com que usa la app)
EMAIL_HOST=mail.araratchile.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=notificaciones@araratchile.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notificaciones@araratchile.com
COTIZACIONES_NOTIFY_EMAIL=notificaciones@araratchile.com
